# Real Cloud Run domain, set after the first deploy (see README "Deploy").
PUBLIC_DOMAIN=your-service-xxxxx.us-central1.run.app

# x402 (pay-per-call in USDC, Base Sepolia testnet). RECEIVING wallet --
# reuse the org treasury address (0x70e9f8057bb50e31b6ee06958bcbbe7de9daa98f),
# NOT the funded test wallet (X402_TEST_WALLET_ADDRESS in the repo root .env)
# -- that one pays, it doesn't receive. Using the payer wallet as its own
# payTo makes the facilitator reject every payment ("invalid_exact_evm_signature"
# self-payment bug, see skills/x402-payments).
X402_WALLET_ADDRESS=0x70e9f8057bb50e31b6ee06958bcbbe7de9daa98f

# 402index.io claim verification hash -- set after POST /api/v1/claim
# against the real deployed domain (see README "Distribution").
NEXUS_402INDEX_VERIFY_HASH=

# Telemetry (traffic_events / mcp_call_events / revenue_events) -- anon key only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
